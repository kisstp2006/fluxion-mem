// SPDX-License-Identifier: BSL-1.0
//
// This file is for building fluxion-mem on its own: `c3c test` runs the
// suite and `c3c run demo` runs the tour. A consumer never reads it. They
// point `dependency-search-paths` at this directory and name `fluxion_mem`,
// which the compiler resolves through fluxion_mem.c3l/manifest.json.
{
  "langrev": "1",
  "version": "0.1.0",
  "authors": ["TIGames <kisstp2006@gmail.com>"],

  // The library itself. Tests live in these files, marked @test, so
  // `c3c test` needs nothing more than this.
  "sources": ["src/**"],
  "output": "build",

  "targets": {
    // c3c run demo
    "demo": {
      "type": "executable",
      "sources": ["examples/demo.c3"]
    }
  }
}
