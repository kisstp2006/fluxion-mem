# Everything `c3c` produces: `project.json5` sets the output directory to
# `build/`, and that is where the test runner, the demo and the objects
# behind them land. All of it is derived from the source in this repo.
build/

# Ad-hoc builds that bypass the project file - `c3c compile some_file.c3`,
# `c3c compile-run` - drop their output next to the source instead.
*.exe
*.pdb
*.ilk
*.exp
*.obj
*.o
*.lib
*.a
*.dll
*.so
*.so.*
*.dylib
*.wasm

# What a run that ended badly leaves behind. Large, machine-specific, and
# worth nothing once the bug it came from is fixed.
core
core.*
*.stackdump
vgcore.*

# Editor and tooling leavings. `.cache/` is clangd's index, which grows to
# tens of megabytes and is rebuilt from the source anyway.
.vscode/
.idea/
.vs/
.zed/
.cache/
*.swp
*.swo
*~

# OS leavings.
.DS_Store
._*
Thumbs.db
desktop.ini
